---
import { TOPIC_KEYS } from '../lib/topics';
import type { Lang } from '../i18n/ui';
import { guideUi } from '../lib/expandedGuides';

interface Props {
  lang: Lang;
  messages: Record<string, any>;
}
const { lang, messages } = Astro.props;
const topics = messages.topics;
---

<section class="bg-sand py-16">
  <div class="max-w-7xl mx-auto px-5">
    <h2 class="font-display font-semibold text-3xl md:text-4xl text-teak">{topics.ui.sectionTitle}</h2>
    <p class="mt-3 max-w-2xl text-ink/75">{topics.ui.sectionLead}</p>

    <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {TOPIC_KEYS.map((key) => {
        const topic = topics[key];
        return (
          <a
            href={`/${lang}/${topic.slug}/`}
            class="group rounded-2xl border border-gold/30 bg-white/60 p-5 transition-colors hover:border-gold hover:shadow-md"
          >
            <p class="text-[11px] uppercase tracking-wide text-ink/60">{topic.label}</p>
            <div class="mt-1 font-display font-semibold text-teak">{topic.title}</div>
            <p class="mt-2 text-sm text-ink/70">{topic.lead}</p>
            <span class="mt-3 inline-block text-sm text-gold group-hover:text-goldBright">→</span>
          </a>
        );
      })}
    </div>
    <div class="mt-7 text-center">
      <a href={`/${lang}/guides/`} class="inline-flex rounded-full border border-gold/50 px-6 py-3 font-semibold text-teak hover:bg-white/60">{guideUi[lang].hub} · 31 →</a>
    </div>
  </div>
</section>
