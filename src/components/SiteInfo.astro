---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; messages: Record<string, any> }
const { lang, messages } = Astro.props;
const footer = messages.footer;
const title = { zh: '关于本站', en: 'About this guide', th: 'เกี่ยวกับเว็บไซต์นี้' }[lang];
---
<section class="bg-ivory text-ink pb-16" id="site-information">
  <div class="max-w-7xl mx-auto px-5">
    <div class="rounded-3xl border border-gold/25 bg-sand/70 p-7 md:p-10 grid md:grid-cols-2 gap-8">
      <div>
        <h2 class="font-display text-2xl text-teak">{title}</h2>
        <p class="font-display text-xl text-teak mt-4">{footer.brand.name}</p>
        <p class="font-hand text-gold mt-1">{footer.brand.tagline}</p>
        <p class="mt-4 leading-relaxed text-ink/80">{footer.about}</p>
        <p class="mt-3 text-ink/75">{footer.unofficial}</p>
        <p class="mt-3 text-ink/75">{footer.disclaimerLead}</p>
      </div>
      <div class="space-y-3 text-sm text-ink/75">
        <h3 class="font-display text-xl text-teak">{footer.noteTitle}</h3>
        <p>{footer.dataSource}</p>
        <p>{footer.lastUpdated}</p>
        <p>{footer.note}</p>
        <a href={siteConfig.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-block text-gold hover:underline">{footer.mapsLabel}</a>
        <nav class="flex flex-wrap gap-x-5 gap-y-2 pt-3 text-gold" aria-label={title}>
          <a class="hover:underline" href={`/${lang}/image-sources/`}>{messages.sources.heading}</a>
          <a class="hover:underline" href={`/${lang}/privacy-policy/`}>{footer.privacy}</a>
          <a class="hover:underline" href={`/${lang}/terms-of-service/`}>{footer.terms}</a>
          <a class="hover:underline" href={`/${lang}/cookie-settings/`}>{footer.cookies}</a>
        </nav>
      </div>
    </div>
  </div>
</section>
