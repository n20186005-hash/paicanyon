---
import type { Lang } from '../i18n/ui';
import { nearby, nearbyCopy, nearbyMap } from '../lib/nearby';
interface Props { lang: Lang }
const { lang } = Astro.props;
const copy = {
  en: { title: 'Explore More Around Pai', lead: 'Three practical stops to combine with Pai Canyon, each with its own location and route advice.', detail: 'Explore guide', map: 'Map' },
  th: { title: 'เที่ยวต่อรอบเมืองปาย', lead: 'สามจุดแวะเที่ยวที่จัดคู่กับปายแคนยอนได้ พร้อมข้อมูลและแผนที่แยกแต่ละแห่ง', detail: 'อ่านคู่มือ', map: 'แผนที่' },
  zh: { title: '拜县大峡谷周边游览', lead: '精选三个适合串联的地点，各自提供路线说明与独立地图定位。', detail: '查看攻略', map: '地图' },
}[lang];
const slugs = ['pai-memorial-bridge', 'tha-pai-hot-spring', 'pai-walking-street'] as const;
---
<section class="bg-sand py-16" id="nearby-guides">
  <div class="mx-auto max-w-7xl px-5">
    <h2 class="font-display font-semibold text-3xl md:text-4xl text-teak">{copy.title}</h2>
    <p class="mt-3 max-w-2xl text-ink/75">{copy.lead}</p>
    <div class="mt-8 grid md:grid-cols-3 gap-5">
      {slugs.map((slug) => {
        const place = nearby[slug];
        return <article class="rounded-2xl bg-white/70 border border-gold/25 p-6">
          <h3 class="font-display font-semibold text-xl text-teak">{nearbyCopy(place.name, lang)}</h3>
          <p class="mt-3 text-ink/75 text-sm leading-relaxed">{nearbyCopy(place.observe, lang)}</p>
          <div class="mt-5 flex gap-5 text-sm"><a class="text-gold font-semibold hover:underline" href={`/${lang}/guides/${slug}/`}>{copy.detail} →</a><a class="text-teak hover:underline" href={nearbyMap(place.query)} target="_blank" rel="noopener noreferrer">{copy.map} ↗</a></div>
        </article>;
      })}
    </div>
  </div>
</section>
