---
interface Props {
  messages: Record<string, any>;
}
const { messages } = Astro.props;
const f = messages.facilities;
---

<section id="facilities" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-5">
    <p class="font-hand text-gold text-xl md:text-2xl">{f.label}</p>
    <h2 class="font-display font-semibold text-3xl md:text-5xl text-teak mt-2">{f.heading}</h2>
    <p class="mt-4 max-w-3xl text-ink/80">{f.lead}</p>

    <p class="mt-5 max-w-3xl rounded-xl border border-gold/30 bg-sand px-4 py-3 text-sm text-ink/80">
      {f.neutralNote}
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 mt-9">
      {f.items.map((it: any) => (
        <article class="rounded-2xl border border-gold/25 bg-ivory p-5 flex flex-col hover:border-gold transition-colors">
          <span class="text-3xl leading-none">{it.emoji}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-teak">{it.name}</h3>
          <p class="mt-2 text-sm text-ink/80 flex-1">{it.desc}</p>
          <p class="mt-3 inline-flex w-fit rounded-full border border-gold/40 bg-white/60 px-3 py-1 text-[11px] text-ink/70">
            {it.hint}
          </p>
        </article>
      ))}
    </div>

    <p class="mt-6 text-xs text-ink/60">{f.closeNote}</p>
  </div>
</section>
