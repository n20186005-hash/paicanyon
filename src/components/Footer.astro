---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; messages: Record<string, any> }
const { lang } = Astro.props;
const statement = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  th: 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ',
}[lang];
const rights = { zh: '版權所有', en: 'All rights reserved', th: 'สงวนลิขสิทธิ์' }[lang];
---
<footer class="bg-teakDeep text-ivory py-9">
  <div class="max-w-7xl mx-auto px-5 text-center text-sm text-ivory/75 space-y-3">
    <p>© 2026 {siteConfig.name[lang]} · {rights}.</p>
    <p>{statement}</p>
  </div>
</footer>
