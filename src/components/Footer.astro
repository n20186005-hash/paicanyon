---
import { siteConfig } from '../config';
import type { Lang } from '../i18n/ui';
interface Props { lang: Lang; messages: Record<string, any> }
const { lang, messages } = Astro.props;
const statement = {
  zh: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。',
  en: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.',
  th: 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ ไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ',
}[lang];
const rights = { zh: '版權所有', en: 'All rights reserved', th: 'สงวนลิขสิทธิ์' }[lang];
---
<footer class="bg-teakDeep text-ivory py-9">
  <div class="max-w-7xl mx-auto px-5 flex flex-col gap-5 md:flex-row md:items-center md:justify-between text-sm text-ivory/75">
    <div class="space-y-3 text-center md:text-left">
      <p>© 2026 {siteConfig.name[lang]} · {rights}.</p>
      <p>{statement}</p>
    </div>
    <nav class="flex flex-wrap justify-center md:justify-end gap-x-5 gap-y-2 shrink-0" aria-label="Legal pages">
      <a href={`/${lang}/privacy-policy/`} class="hover:text-goldBright hover:underline">{messages.footer.privacy}</a>
      <a href={`/${lang}/terms-of-service/`} class="hover:text-goldBright hover:underline">{messages.footer.terms}</a>
      <a href={`/${lang}/cookie-settings/`} class="hover:text-goldBright hover:underline">{messages.footer.cookies}</a>
    </nav>
  </div>
</footer>
